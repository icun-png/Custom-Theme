<?xml version="1.0" encoding="utf-8"?>
  <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
      android:id="@+id/dreamContent"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true">

      <!-- Full-screen wallpaper -->
      <ImageView
          android:id="@+id/dreamAmbient"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop" />

      <!-- Frosted glass panel (centered) -->
      <LinearLayout
          android:id="@+id/dreamPanel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:orientation="vertical"
          android:gravity="center_horizontal"
          android:paddingHorizontal="48dp"
          android:paddingVertical="32dp">

          <!-- Day name (Friday) -->
          <TextView
              android:id="@+id/dreamDay"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#FFFFFF"
              android:textSize="24sp"
              android:letterSpacing="0.02"
              android:alpha="0.8" />

          <!-- Clock (thin, large) -->
          <TextView
              android:id="@+id/dreamClock"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:textColor="#FFFFFF"
              android:textSize="120sp"
              android:fontFamily="@font/outfit_thin"
              android:letterSpacing="-0.02" />

          <!-- Date (October 30, 2026) -->
          <TextView
              android:id="@+id/dreamDate"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:textColor="#FFFFFF"
              android:textSize="28sp"
              android:fontFamily="@font/outfit_light"
              android:letterSpacing="0.01"
              android:alpha="0.9" />

      </LinearLayout>

  </FrameLayout>

